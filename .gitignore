.godot/
*.tmp
build/
.build/
__pycache__/

# Release binaries are built by tools/build_windows_exe.sh and published as
# GitHub Release assets: GitHub refuses to push files over 100 MB.
release/*
!release/README.md

# Generated by port-carrick/build_viewer.py
port-carrick/port-carrick-map.html
port-carrick/__pycache__/

# Godot imports whatever it finds under tests/results (CSV reports become translations,
# screenshots become textures); the evidence is the files themselves, not their imports.
tests/results/**/*.import
tests/results/**/*.translation
tests/results/**/*.uid
